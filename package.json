{
  "name": "atrium",
  "productName": "Atrium",
  "version": "0.3.4",
  "description": "A beginner-friendly desktop AI agent with visual MCP setup and a built-in marketplace.",
  "main": "./out/main/index.js",
  "author": "Atrium",
  "license": "MIT",
  "private": true,
  "scripts": {
    "runtime:artifacts": "node scripts/build-artifact-runtime.mjs",
    "dev": "npm run runtime:artifacts && electron-vite dev",
    "build": "npm run runtime:artifacts && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run runtime:artifacts && npm run typecheck:node && npm run typecheck:web",
    "test": "node --test --test-timeout=60000 --experimental-strip-types \"test/**/*.test.ts\"",
    "dist": "npm run build && electron-builder --win --dir",
    "dist:installer": "npm run build && electron-builder --win nsis --publish never",
    "release:publish": "node scripts/publish-release.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.11",
    "fflate": "^0.8.3",
    "mammoth": "^1.13.0",
    "mermaid": "^12.3.0",
    "qrcode": "^1.5.4",
    "read-excel-file": "^9.3.17",
    "recharts": "^3.10.1",
    "sucrase": "^3.35.1",
    "undici": "^8.12.4",
    "unpdf": "^2.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/albert-sans": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "i18next": "^27.1.1",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
